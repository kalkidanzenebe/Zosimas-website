# Copy this file to .env and fill in your local MySQL credentials.
# Create the database first:
#   CREATE DATABASE zosimas CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# If the password contains @, encode it as %40 in DATABASE_URL.

DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/zosimas"
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@zosimas.et"
ADMIN_PASSWORD="ChangeMe123!"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Frontend (Vercel). Leave empty for local Vite proxy.
# VITE_API_URL="https://zosimas-website.onrender.com"

