{
  "name": "zosimas-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:push": "prisma db push --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/prisma/seed.ts",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma",
    "seed": "tsx --tsconfig server/tsconfig.json server/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "multer": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.0"
  }
}
